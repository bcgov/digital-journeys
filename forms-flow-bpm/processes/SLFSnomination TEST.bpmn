g>Flow_09rbji4</bpmn:outgoing></bpmn:startEvent><bpmn:task id="Audit_Task_Executed" name="Execute Audit Task"><bpmn:extensionElements><camunda:executionListener event="start"><camunda:script scriptFormat="javascript">execution.setVariable('applicationStatus', 'Completed');</camunda:script></camunda:executionListener><camunda:executionListener class="org.camunda.bpm.extension.hooks.listeners.BPMFormDataPipelineListener" event="start"><camunda:field name="fields"><camunda:expression>["applicationId","applicationStatus"]</camunda:expression></camunda:field></camunda:executionListener><camunda:executionListener class="org.camunda.bpm.extension.hooks.listeners.ApplicationStateListener" event="end" /></bpmn:extensionElements><bpmn:incoming>Flow_09rbji4</bpmn:incoming><bpmn:outgoing>Flow_1bbnq2k</bpmn:outgoing></bpmn:task><bpmn:task id="Activity_09ppf3b" name="Set global variables"><bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="employeeName">${firstName} ${lastName}</camunda:outputParameter><camunda:outputParameter name="deadlineDate">TBD</camunda:outputParameter><camunda:outputParameter name="deadlineTime">5 pm</camunda:outputParameter><camunda:outputParameter name="surveyLink">https://${surveyUrl}?respondent_form_id=${applicationId}&amp;etc=${etc}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_1bbnq2k</bpmn:incoming><bpmn:outgoing>Flow_1xqii69</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Event_1ws2h5w" name="Default Flow Ended"><bpmn:incoming>Flow_1mppk17</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0ggok9j" sourceRef="Activity_0ukkgg5" targetRef="Activity_sendNominationEmailToSupervisor"><bpmn:extensionElements /></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_11xhirk" sourceRef="Activity_sendNominationEmailToSupervisor" targetRef="Gateway_0f9k9r9" /><bpmn:sequenceFlow id="Flow_0klorcg" sourceRef="Gateway_03sx0fe" targetRef="Activity_0ukkgg5"><bpmn:extensionElements /></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_0vk1ju4" sourceRef="Gateway_03sx0fe" targetRef="Activity_0ihi2b8" /><bpmn:sequenceFlow id="Flow_16u8kkz" sourceRef="Activity_0ihi2b8" targetRef="Activity_1rhw45x" /><bpmn:sequenceFlow id="Flow_1fj268w" sourceRef="Gateway_03sx0fe" targetRef="Activity_0dwqqd2" /><bpmn:sequenceFlow id="Flow_07o3rnu" sourceRef="Activity_0dwqqd2" targetRef="Activity_0qftqai" /><bpmn:sequenceFlow id="Flow_16gc484" sourceRef="Activity_0qftqai" targetRef="Gateway_0f9k9r9" /><bpmn:sequenceFlow id="Flow_0c9p49a" sourceRef="Gateway_03sx0fe" targetRef="Activity_0bobsix" /><bpmn:sequenceFlow id="Flow_19j3d2n" sourceRef="Activity_0bobsix" targetRef="Gateway_0njd4fx" /><bpmn:sequenceFlow id="Flow_0362hob" sourceRef="Activity_1dm30p0" targetRef="Gateway_1o9dcco" /><bpmn:sequenceFlow id="Flow_09rbji4" sourceRef="StartEvent_1" targetRef="Audit_Task_Executed"><bpmn:extensionElements><camunda:executionListener event="take"><camunda:script scriptFormat="javascript">execution.setVariable('applicationStatus', 'New'); execution.setVariable('respondent_form_id', execution.getVariable("applicationId"));execution.setVariable('application_id', execution.getVariable("applicationId"));</camunda:script></camunda:executionListener><camunda:executionListener class="org.camunda.bpm.extension.hooks.listeners.BPMFormDataPipelineListener" event="take"><camunda:field name="fields"><camunda:expression>["applicationId","applicationStatus","respondent_form_id","application_id"]</camunda:expression></camunda:field></camunda:executionListener><camunda:executionListener class="org.camunda.bpm.extension.hooks.listeners.FormBPMDataPipelineListener" event="take" /></bpmn:extensionElements></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_1bbnq2k" sourceRef="Audit_Task_Executed" targetRef="Activity_09ppf3b"><bpmn:extensionElements /></bpmn:sequenceFlow><bpmn:parallelGateway id="Gateway_03sx0fe"><bpmn:incoming>Flow_1xqii69</bpmn:incoming><bpmn:outgoing>Flow_0vk1ju4</bpmn:outgoing><bpmn:outgoing>Flow_0c9p49a</bpmn:outgoing><bpmn:outgoing>Flow_1fj268w</bpmn:outgoing><bpmn:outgoing>Flow_0klorcg</bpmn:outgoing></bpmn:parallelGateway><bpmn:sequenceFlow id="Flow_1xqii69" sourceRef="Activity_09ppf3b" targetRef="Gateway_03sx0fe" /><bpmn:sequenceFlow id="Flow_1t6mw6s" sourceRef="Gateway_0f9k9r9" targetRef="Event_10zi2lc" /><bpmn:sequenceFlow id="Flow_0q9ik52" sourceRef="Activity_1rhw45x" targetRef="Activity_0raniju" /><bpmn:parallelGateway id="Gateway_0f9k9r9"><bpmn:incoming>Flow_16gc484</bpmn:incoming><bpmn:incoming>Flow_11xhirk</bpmn:incoming><bpmn:incoming>Flow_0jkzkp0</bpmn:incoming><bpmn:incoming>Flow_0iolclw</bpmn:incoming><bpmn:outgoing>Flow_1t6mw6s</bpmn:outgoing></bpmn:parallelGateway><bpmn:intermediateCatchEvent id="Event_10zi2lc" name="Reminder 2025-11-04"><bpmn:incoming>Flow_1t6mw6s</bpmn:incoming><bpmn:outgoing>Flow_03nbl0g</bpmn:outgoing><bpmn:timerEventDefinition id="TimerEventDefinition_0cqxsk2"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">2025-11-07T16:01:14Z</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:serviceTask id="Activity_006o9e7" name="Send nomination email to supervisor" camunda:class="org.camunda.bpm.extension.hooks.listeners.TaskAssignmentListener"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="body">Dear ${supervisorFirstName} ${supervisorLastName},
&lt;p&gt;
If you&amp;apos;ve already completed the Senior Leader Feedback Survey (SLFS), thank you! No further action is required.
&lt;br&gt;
If not, this is a friendly reminder that the deadline to complete the survey is approaching. While your participation is voluntary, your feedback is essential to the value of the SLFS. Please take the time to provide your honest feedback to the senior leader(s) who requested it. You were selected for a reason, and your perspective matters.
&lt;/p&gt;

&lt;ul&gt;
  &lt;li&gt;Survey deadline: ${deadlineDate} ${deadlineTime}&lt;/li&gt;
  &lt;li&gt;Time required: 20 minutes&lt;/li&gt;
&lt;li&gt;Survey link: &lt;a href='${surveyLink}'&gt;${surveyLink}&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;p&gt;To support your anonymity when completing the survey, please do not include details that could identify you or others in your responses. The survey includes a feature that identifies language that may be considered strong or reveal your identity and provides an alternate option with the intent of prioritising constructive feedback and your anonymity. You can choose to accept the suggestion or keep your original message.
&lt;/p&gt;
&lt;p&gt;
Your feedback supports leadership learning and development across the BC Public Service. Thank you again for your time and thoughtful contribution.
&lt;/p&gt;

&lt;/ul&gt;
&lt;p&gt;Warm regards, &lt;br&gt;
The SLFS Team&lt;br&gt;
&lt;a href='mailto:Corporateleadership@gov.bc.ca'&gt;corporateleadership@gov.bc.ca&lt;/a&gt;&lt;/p&gt;</camunda:inputParameter><camunda:inputParameter name="subject">SLFS Reminder: Complete the survey for ${firstName} ${lastName} by ${deadlineDate} ${deadlineTime}</camunda:inputParameter><camunda:inputParameter name="recipientEmails">${supervisorEmailAddress}</camunda:inputParameter><camunda:inputParameter name="sender">Corporateleadership@gov.bc.ca</camunda:inputParameter><camunda:inputParameter name="senderAlias">Corporate Leadership</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_1qr54yz</bpmn:incoming><bpmn:outgoing>Flow_0c9qoyn</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Activity_1cuntbf" name="Send nomination email to colleagues" camunda:class="org.camunda.bpm.extension.hooks.listeners.TaskAssignmentListener"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="body">Hello,
&lt;p&gt;
